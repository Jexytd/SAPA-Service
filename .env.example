# ============================================================
# SAPA BPS Backend Environment Configuration Example
# ============================================================

# Port server backend lokal Windows (Port 80 untuk tunnel ngrok)
PORT=80

# Domain origin frontend yang diizinkan CORS (pisahkan dengan koma jika lebih dari satu)
FRONTEND_URL=http://localhost:3000,https://footless-aptitude-caloric.ngrok-free.dev

# Public ngrok endpoint untuk informasi service
BACKEND_PUBLIC_URL=https://footless-aptitude-caloric.ngrok-free.dev

# API Key untuk proteksi endpoint sensitif dari internet luar
API_KEY=your_secret_api_key_here

# Groq Cloud API Key (Optional)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=groq/compound-mini

# Optional Local AI fallback
LOCAL_LLM_URL=http://127.0.0.1:1234/v1/chat/completions
LOCAL_LLM_MODEL=qwen2-vl-2b-instruct

# TiDB Cloud Database (Optional sync)
DB_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com
DB_PORT=4000
DB_USER=your_user
DB_PASSWORD=your_password
DB_NAME=sapa_bangka
